# =============================================================================
# AME-Chip — git ignore rules
# Policy: source, docs, reports (markdown), curated final deliverables are
# tracked. Everything regenerable (EDA run databases, logs, sim build dirs,
# intermediates) is ignored. Final GDS/SDF are tracked as .gz (GitHub <100MB).
# =============================================================================

# ---- Python ----
__pycache__/
*.pyc

# ---- EDA binaries / run databases (regenerable by release_check.sh / ORFS) ----
*.odb
*.def
*.spef
*.vcd
*.fst
*.rtlil
results/
logs/

# ---- GDS/SDF: only the gzipped final copies under p4a4fix are tracked ----
*.gds
*.gds.gz
!pnr/amechip/results/sky130hd/amechip/p4a4fix/6_final.gds.gz
*.sdf
!pnr/amechip/results/sky130hd/amechip/p4a4fix/6_final.sdf.gz

# ---- DRC/STA raw report dumps (summaries live in reports/*.md) ----
*.rpt
!reports/P4READY_drc_load_test.rpt

# ---- ORFS run trees: keep only the final variant's curated files ----
pnr/amechip/results/sky130hd/amechip/p1bxb/
pnr/amechip/results/sky130hd/amechip/p4a0/
pnr/amechip/results/sky130hd/amechip/p4a0rom/
pnr/amechip/results/sky130hd/amechip/p4a1/
pnr/amechip/results/sky130hd/amechip/p4a2/
pnr/amechip/results/sky130hd/amechip/p4a2_gds1_keep/
pnr/amechip/results/sky130hd/amechip/p4a3/
pnr/amechip/results/sky130hd/amechip/p4a3fin/
pnr/amechip/results/sky130hd/amechip/p4a3rtl03/
pnr/amechip/results/sky130hd/amechip/p4a4/
pnr/amechip/results/sky130hd/amechip/p4a5/
pnr/amechip/results/sky130hd/amechip/p4atd/
pnr/amechip/archive*/

# ---- Synthesis scratch / probe runs ----
syn/work/

# ---- Simulation build & scratch dirs ----
build/
tb/*/build/
tb/*/work/
tb/*/obj_dir/
**/__pycache__/
*.ops

# ---- Generated hex/mem artifacts (regenerated by build_hex.py / golden_reader.py) ----
tb/soc/build/p3d_*.hex
tb/soc/build/*.log

# ---- Logs anywhere ----
*.log

# ---- Internal session-orchestration file (Chinese working notes, not part of
#      the public deliverable; the English process summary is docs/PROCESS.md) ----
PLAN_AND_PROMPTS.md

# ---- Internal Chinese working archive (per-session records; kept on disk only) ----
docs/AME_ISA.md
docs/AME_NOTES.md
docs/ARCH_SPEC.md
docs/CONTRACT_PATCH_LOG.md
docs/CPU_NOTES.md
docs/ENV.md
docs/GOLDEN_SPEC.md
docs/MEM_NOTES.md
docs/SOC_NOTES.md
docs/WORKLOAD.md
reports/P3A_REPORT.md
reports/P3B_PERF.md
reports/P3B_REPORT.md
reports/P3C_REPORT.md
reports/P3D_REPORT.md
reports/P4A0_REPORT.md
reports/P4A0_TOP20_TABLE.md
reports/P4A2_REPORT.md
reports/P4A3_REPORT.md
reports/P4A4_REPORT.md
reports/P4A_REPORT.md
reports/P4B2_REPORT.md
reports/P4B_REPORT.md
reports/P4B_gds_census.md
reports/P4READY.md
reports/TAPEOUT_CHECKLIST_TEMPLATE.md
reports/env-check/
reports/issues/
reports/*.png
reports/*.rpt

# ---- Golden dataset / model sources: regenerated by scripts/gld_gen.py + gld_verify.py (kept on disk, not in the public snapshot) ----
models/
